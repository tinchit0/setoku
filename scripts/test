#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

BOLD='\033[1m'; RED='\033[0;31m'; GREEN='\033[0;32m'; RESET='\033[0m'
ERRORS=0

log()  { printf "\n${BOLD}%s${RESET}\n" "$*"; }
fail() { printf "${RED}✗ %s${RESET}\n" "$*"; ERRORS=$((ERRORS + 1)); }
ok()   { printf "${GREEN}✓ %s${RESET}\n" "$*"; }

log "▸ Tests backend (pytest)…"
cd "$ROOT/backend"
if [[ ! -f .venv/bin/pytest ]]; then
  fail "pytest no encontrado — ejecuta scripts/dev primero para crear el entorno"
else
  .venv/bin/pytest --tb=short -q && ok "backend" || fail "backend"
fi

log "▸ Tests frontend (vitest)…"
cd "$ROOT/frontend"
npm test -- --run && ok "frontend" || fail "frontend"

echo ""
(( ERRORS == 0 )) && printf "${BOLD}Todo OK.${RESET}\n" || { printf "${RED}${ERRORS} suite(s) fallaron.${RESET}\n"; exit 1; }
