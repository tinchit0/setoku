#!/usr/bin/env bash
set -euo pipefail

: "${DEPLOY_HOST:?DEPLOY_HOST not set}"
: "${DEPLOY_PATH:?DEPLOY_PATH not set}"

SOURCE="${1:-}"
if [[ -z "$SOURCE" ]]; then
  echo "Uso: db-restore <archivo.db>" >&2
  exit 1
fi

echo "▶ Parando contenedor..."
ssh "$DEPLOY_HOST" "docker stop setoku 2>/dev/null || true"

echo "▶ Subiendo $SOURCE a $DEPLOY_HOST..."
ssh "$DEPLOY_HOST" "mkdir -p '${DEPLOY_PATH}/data'"
cat "$SOURCE" | ssh "$DEPLOY_HOST" "docker run --rm -i \
  -v '${DEPLOY_PATH}/data:/data' \
  --entrypoint /bin/sh \
  setoku -c 'cat > /data/setoku.db'"

echo "▶ Reiniciando contenedor..."
ssh "$DEPLOY_HOST" "cd '$DEPLOY_PATH' && docker compose up -d"

echo "✓ BD restaurada desde $SOURCE"
