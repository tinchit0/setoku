#!/usr/bin/env bash
set -euo pipefail

: "${DEPLOY_HOST:?DEPLOY_HOST not set}"
: "${DEPLOY_PATH:?DEPLOY_PATH not set}"

DEST="backups/setoku-$(date +%Y%m%d-%H%M%S).db"
mkdir -p backups

echo "▶ Descargando BD desde $DEPLOY_HOST..."
scp "$DEPLOY_HOST:$DEPLOY_PATH/data/setoku.db" "$DEST"

echo "✓ Guardado en $DEST"
